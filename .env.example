# ==========================================
# Modular RAG System Configuration
# ==========================================

# ── Vector Database Config ──
CHROMA_PATH=./chroma_db

# ── Redis Config (Chat History Cache) ──
REDIS_URL=redis://localhost:6379/0

# ── Default LLM Model ──
# Examples:
#   API Models:
#     - openai:gpt-4o
#     - openai:gpt-4o-mini
#     - anthropic:claude-3-5-sonnet-20241022
#     - gemini:gemini-2.5-flash
#     - groq:llama-3.3-70b-versatile
#     - deepseek:deepseek-chat
#     - mistral:mistral-large-latest
#     - openrouter:anthropic/claude-3.5-sonnet
#     - together:meta-llama/Llama-3.3-70B-Instruct-Turbo
#     - fireworks:accounts/fireworks/models/llama-v3p3-70b-instruct
#   Hugging Face Downloaded Weights Directory:
#     - /path/to/downloaded/model-directory (containing config.json, model.safetensors)
#     - ./models/my-hf-model
#   Local Weights / GGUF:
#     - weights:/path/to/model.gguf
#     - ./models/llama-3-8b.gguf
#   Local Server (Ollama / llama.cpp):
#     - ollama:llama3:latest
#     - llamacpp:local-model
LLM_MODEL=llama3:latest

# ── Cloud LLM API Keys & Endpoints ──
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com

GEMINI_API_KEY=
# or GOOGLE_API_KEY=

GROQ_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
TOGETHER_API_KEY=
FIREWORKS_API_KEY=

# ── Local Server Config ──
OLLAMA_BASE_URL=http://localhost:11434
LLAMACPP_HOST=http://localhost:8080

# ── Local Weights Hardware Acceleration ──
# Options: auto (auto-detects MPS on Apple Silicon, CUDA on Nvidia, or CPU), mps, cuda, cpu
WEIGHTS_DEVICE=auto

# ── Embedding Model Config (via Ollama or local) ──
EMBEDDING_MODEL_NAME=nomic-embed-text

# ── Server Config ──
HOST=0.0.0.0
PORT=8000

# ── Chunking Strategy ──
# Options: recursive, semantic
CHUNKING_STRATEGY=recursive
